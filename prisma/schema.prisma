// Mothership data model.
// Every business record carries companyId so each moving company (tenant) only sees its own data.
// Local development uses SQLite; switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Quote template: branding and boilerplate copied into each new quote.
  displayName                String?
  logo                       String?
  quoteIntro                 String?
  quoteInvestmentHeading     String?
  quoteValuation             String?
  quoteOptionalValuation     String?
  quoteCompanyDuties         String?
  quoteClientDuties          String?
  // Policies printed under the rate card (travel time, overtime, minimums).
  rateCardNotes              String?

  users      User[]
  accounts   Account[]
  contacts   Contact[]
  projects   Project[]
  activities Activity[]
  vendors    Vendor[]
  rateItems  RateItem[]
  quotes     Quote[]
}

// Roles: ADMIN, SALES, PROJECT_MANAGER, WAREHOUSE, CREW
model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SALES")
  title        String?
  // Signature image (data URL) printed on quotes this person prepares.
  signature    String?
  createdAt    DateTime @default(now())

  ownedAccounts   Account[]  @relation("AccountOwner")
  managedProjects Project[]  @relation("ProjectManager")
  activities      Activity[]
  quotes          Quote[]
}

model Account {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  industry  String?
  website   String?
  phone     String?
  address   String?
  // Where the account came from: MANUAL, APOLLO, HUBSPOT
  source    String   @default("MANUAL")
  ownerId   String?
  owner     User?    @relation("AccountOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  projects   Project[]
  activities Activity[]

  @@index([companyId])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId])
}

// Stages: LEAD, SURVEY, QUOTED, BOOKED, IN_PROGRESS, COMPLETED, LOST
model Project {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  stage              String    @default("LEAD")
  originAddress      String?
  destinationAddress String?
  moveDate           DateTime?
  estimatedValue     Int?
  managerId          String?
  manager            User?     @relation("ProjectManager", fields: [managerId], references: [id])
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activities Activity[]
  quotes     Quote[]

  @@index([companyId, stage])
}

// Types: NOTE, CALL, EMAIL, MEETING, STAGE_CHANGE
model Activity {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("NOTE")
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, accountId])
}

// Vendors and partner movers the sales team works with, one row per vendor contact.
// Category is the vendor type (e.g. "Interstate Movers", "Crane Rentals"), matching the sheets in the vendor file.
model Vendor {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  category           String
  // Row order from the imported file; new vendors added in the app go last.
  position           Int      @default(0)
  name               String
  memberId           String?
  state              String?
  contactName        String?
  phone              String?
  email              String?
  address            String?
  website            String?
  markets            String?
  verificationStatus String?
  currentEmployer    String?
  previousContact    String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, category])
}

// The company's standard prices (the rate sheet), used to fill quote lines so every rep
// prices the same way. Category is a rate sheet section such as "Project Crew Rates". Rates are in cents.
model RateItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  category  String
  name      String
  unit      String
  rateCents Int
  notes     String?
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

// A client proposal ("Project Recommendation Plan"). Statuses: DRAFT, SENT, ACCEPTED, DECLINED.
// Money is in cents; the total is stored for fast lists. Boilerplate (intro, valuation, terms)
// is copied from the company's quote template when the quote is created, then editable per quote.
model Quote {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number              Int
  title               String
  status              String    @default("DRAFT")
  quoteDate           DateTime
  recipientName       String?
  recipientTitle      String?
  recipientCompany    String?
  recipientPhone      String?
  recipientEmail      String?
  clientLogo          String?
  clientLabel         String
  serviceDescription  String
  intro               String
  scopeTitle          String
  timeline            String?
  scope               String?
  investmentHeading   String
  totalLabel          String
  valuation           String
  optionalValuation   String?
  companyDuties       String
  clientDuties        String
  totalCents          Int       @default(0)
  createdById         String
  createdBy           User      @relation(fields: [createdById], references: [id])
  sentAt              DateTime?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lines QuoteLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

// One priced line in the Financial Investment section. Note is shown in brackets after the price;
// when blank and quantity isn't 1, the quantity and rate are shown instead.
model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int
  category    String
  description String
  quantity    Float
  unit        String
  rateCents   Int
  amountCents Int
  note        String?
}
